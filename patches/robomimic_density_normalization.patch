+def _scale_tril_from_raw(raw, action_dim, activation, min_std, max_std=None):
+    """Convert packed lower-triangle parameters into a valid Cholesky factor."""
+    rows, cols = torch.tril_indices(action_dim, action_dim, device=raw.device)
+    scale_tril = raw.new_zeros(raw.shape[:-1] + (action_dim, action_dim))
+    scale_tril[..., rows, cols] = raw
+    diagonal = torch.diagonal(scale_tril, dim1=-2, dim2=-1)
+    diagonal = activation(diagonal) + min_std
+    if max_std is not None:
+        diagonal = torch.clamp(diagonal, max=max_std)
+    scale_tril = scale_tril - torch.diag_embed(
+        torch.diagonal(scale_tril, dim1=-2, dim2=-1)
+    ) + torch.diag_embed(diagonal)
+    return scale_tril
+
