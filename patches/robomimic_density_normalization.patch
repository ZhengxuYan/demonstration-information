+class ConditionalRealNVPDistribution(D.Distribution):
+    """Batched exact-likelihood distribution backed by a conditional RealNVP."""
+
+    arg_constraints = {}
+    has_rsample = False
+
+    def __init__(self, flow, context, validate_args=None):
+        self.flow = flow
+        self.context = context
+        super().__init__(
+            batch_shape=torch.Size(context.shape[:-1]),
+            event_shape=torch.Size((flow.ac_dim,)),
+            validate_args=validate_args,
+        )
+
+    def _broadcast(self, value):
+        shape = torch.broadcast_shapes(value.shape[:-1], self.context.shape[:-1])
+        value = value.expand(shape + (self.flow.ac_dim,))
+        context = self.context.expand(shape + (self.context.shape[-1],))
+        return value, context
+
+    def log_prob(self, value):
+        value, context = self._broadcast(value)
+        z, log_abs_det = self.flow.action_to_base(value, context)
+        base_log_prob = D.Normal(0.0, 1.0).log_prob(z).sum(dim=-1)
+        return base_log_prob + log_abs_det
+
+    def sample(self, sample_shape=torch.Size()):
+        shape = torch.Size(sample_shape) + self.batch_shape
+        z = torch.randn(
+            shape + self.event_shape,
+            dtype=self.context.dtype,
+            device=self.context.device,
+        )
+        context = self.context
+        for _ in sample_shape:
+            context = context.unsqueeze(0)
+        context = context.expand(shape + (context.shape[-1],))
+        actions, _ = self.flow.base_to_action(z, context)
+        return actions
+
+    @property
+    def mean(self):
+        z = torch.zeros(
+            self.batch_shape + self.event_shape,
+            dtype=self.context.dtype,
+            device=self.context.device,
+        )
+        actions, _ = self.flow.base_to_action(z, self.context)
+        return actions
+
+
+class ConditionalRealNVPActorNetwork(ActorNetwork):
+    """Six-block conditional affine-coupling density for low-dimensional actions."""
+
+    def __init__(
+        self,
+        obs_shapes,
+        ac_dim,
+        mlp_layer_dims,
+        num_blocks=6,
+        hidden_dim=256,
+        context_dim=256,
+        scale_limit=2.0,
+        goal_shapes=None,
+        encoder_kwargs=None,
+    ):
+        if num_blocks <= 0:
+            raise ValueError("num_blocks must be positive")
+        self.num_blocks = int(num_blocks)
+        self.hidden_dim = int(hidden_dim)
+        self.context_dim = int(context_dim)
+        self.scale_limit = float(scale_limit)
+        super().__init__(
+            obs_shapes=obs_shapes,
+            ac_dim=ac_dim,
+            mlp_layer_dims=mlp_layer_dims,
+            goal_shapes=goal_shapes,
+            encoder_kwargs=encoder_kwargs,
+        )
+        self.conditioners = nn.ModuleList(
+            [
+                nn.Sequential(
+                    nn.Linear(ac_dim + context_dim, hidden_dim),
+                    nn.ReLU(),
+                    nn.Linear(hidden_dim, hidden_dim),
+                    nn.ReLU(),
+                    nn.Linear(hidden_dim, 2 * ac_dim),
+                )
+                for _ in range(self.num_blocks)
+            ]
+        )
+        for index in range(self.num_blocks):
+            mask = ((torch.arange(ac_dim) + index) % 2 == 0).float()
+            self.register_buffer("coupling_mask_{}".format(index), mask)
+
+    def _get_output_shapes(self):
+        return OrderedDict(context=(self.context_dim,))
+
+    def _context(self, obs_dict, goal_dict=None):
+        return MIMO_MLP.forward(self, obs=obs_dict, goal=goal_dict)["context"]
+
+    def _params(self, block, masked_action, context, mask):
+        flat_action = masked_action.reshape(-1, self.ac_dim)
+        flat_context = context.reshape(-1, self.context_dim)
+        shift, raw_scale = self.conditioners[block](
+            torch.cat((flat_action, flat_context), dim=-1)
+        ).chunk(2, dim=-1)
+        shift = shift.reshape(masked_action.shape)
+        raw_scale = raw_scale.reshape(masked_action.shape)
+        inverse_mask = 1.0 - mask
+        log_scale = self.scale_limit * torch.tanh(raw_scale) * inverse_mask
+        return shift * inverse_mask, log_scale
+
+    def action_to_base(self, action, context):
+        value = action
+        total_log_det = action.new_zeros(action.shape[:-1])
+        for block in range(self.num_blocks):
+            mask = getattr(self, "coupling_mask_{}".format(block)).to(action)
+            masked = value * mask
+            shift, log_scale = self._params(block, masked, context, mask)
+            value = masked + (1.0 - mask) * (value * torch.exp(log_scale) + shift)
+            total_log_det = total_log_det + log_scale.sum(dim=-1)
+        return value, total_log_det
+
+    def base_to_action(self, base, context):
+        value = base
+        total_log_det = base.new_zeros(base.shape[:-1])
+        for block in reversed(range(self.num_blocks)):
+            mask = getattr(self, "coupling_mask_{}".format(block)).to(base)
+            masked = value * mask
+            shift, log_scale = self._params(block, masked, context, mask)
+            value = masked + (1.0 - mask) * ((value - shift) * torch.exp(-log_scale))
+            total_log_det = total_log_det - log_scale.sum(dim=-1)
+        return value, total_log_det
+
+    def forward_train(self, obs_dict, goal_dict=None):
+        return ConditionalRealNVPDistribution(self, self._context(obs_dict, goal_dict))
+
+    def forward(self, obs_dict, goal_dict=None):
+        return self.forward_train(obs_dict, goal_dict).sample()
+
+    def _to_string(self):
+        return "action_dim={}\nnum_blocks={}\nhidden_dim={}\ncontext_dim={}\nscale_limit={}".format(
+            self.ac_dim,
+            self.num_blocks,
+            self.hidden_dim,
+            self.context_dim,
+            self.scale_limit,
+        )
 
 
